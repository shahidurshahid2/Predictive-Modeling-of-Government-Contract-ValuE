                     df_model["Monthly_Economic_Index"].max(), 200)
ax.plot(x_line, np.expm1(m * x_line + b), color="crimson",
        linewidth=2, label="Trend (log-linear fit)")

ax.set_yscale("log")
ax.set_xlabel("Monthly Economic Index", fontsize=11)
ax.set_ylabel("Contract Value (AUD, log scale)", fontsize=11)
