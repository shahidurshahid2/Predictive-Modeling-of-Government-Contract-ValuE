print("Heatmap saved as heatmap.png")


# %% CELL 12 — SCATTER PLOT 1: Contract Value vs Monthly Economic Index
# -----------------------------------------------------------
# We plot Contract value against the Monthly Economic Index to visually
# inspect whether macro-economic conditions correlate with contract size.
# A regression trend line (via numpy polyfit) is overlaid for clarity.
# The log scale on the y-axis is applied because contract values span
# several orders of magnitude; without it, a handful of large contracts
# would compress the bulk of points into an unreadable band at the bottom.
# -----------------------------------------------------------

fig, ax = plt.subplots(figsize=(8, 5))

ax.scatter(
    df_model["Monthly_Economic_Index"],
    df_model[TARGET],
    alpha=0.4, s=25, color="steelblue", edgecolors="none"
)

# Overlay a linear trend line (in log-space of y for visual coherence)
log_y = np.log1p(df_model[TARGET])
m, b = np.polyfit(df_model["Monthly_Economic_Index"], log_y, 1)
